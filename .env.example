SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Required for admin panel (list all Auth users via service role — same as original setup).
# Supabase Dashboard → Project Settings → API → service_role (never commit!)
# On Lovable: Cloud → Secrets / connected Supabase project usually injects this automatically.
SUPABASE_SERVICE_ROLE_KEY=

# Monobank acquiring (Lovable Cloud → Secrets). Required for course checkout.
MONOBANK_TOKEN=

# Optional. Google Pay gatewayMerchantId from web.monobank.ua merchant settings.
# If unset, the server falls back to Monobank merchantId from /api/merchant/details.
MONOBANK_GOOGLE_GATEWAY_MERCHANT_ID=

# Optional native Apple Pay (host-to-host). Requires Apple Developer Merchant ID,
# domain verification, Merchant Identity cert PEMs, and Payment Processing cert
# shared with Monobank. Without these, use Google Pay or card.
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_CERT_PEM=
APPLE_PAY_MERCHANT_KEY_PEM=
