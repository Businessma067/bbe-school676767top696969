SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Required for admin panel (list all Auth users via service role — same as original setup).
# Supabase Dashboard → Project Settings → API → service_role (never commit!)
# On Lovable: Cloud → Secrets / connected Supabase project usually injects this automatically.
SUPABASE_SERVICE_ROLE_KEY=

# Monobank acquiring (Lovable → More → Cloud → Secrets).
# Name must be exactly MONOBANK_TOKEN (server-only; never use a VITE_ prefix).
# Required for course checkout whether payment opens on-site or on Monobank's page.
MONOBANK_TOKEN=
